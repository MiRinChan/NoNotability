[Script]
http-response ^https:\/\/notability\.com\/global(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MiRinChan/NoNotability/main/NoNotability.js,requires-body=true,timeout=10,tag=Notability iCloud Guard,enable=true
http-response ^https:\/\/notability\.com\/global\/zendesk\/.* script-path=https://raw.githubusercontent.com/MiRinChan/NoNotability/main/NoNotability.js,requires-body=true,timeout=10,tag=Notability Announcement,enable=true

